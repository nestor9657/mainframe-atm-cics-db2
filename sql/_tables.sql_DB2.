 (                                                       
     NUM_CUENTA                                          
 );                                                  




CREATE TABLE BANC_OPCIONES                                    
(                                                             
    OPCION        CHAR(02)    NOT NULL,                       
    DESCRIPCION   VARCHAR(60) NOT NULL,                       
    PROGRAMA_CICS CHAR(08)    NOT NULL,                       
