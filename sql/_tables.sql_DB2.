 CREATE TABLE BANC_CLIENTE                         
 (                                                 
     NUM_CUENTA CHAR(10)    NOT NULL,              
     DNI        CHAR(09)    NOT NULL,              
     NOMBRE     VARCHAR(40) NOT NULL,              
     APELLIDOS  VARCHAR(60) NOT NULL,              
     FECHA_ALTA DATE        NOT NULL,              
     ESTADO     CHAR(01)    NOT NULL DEFAULT 'A',  
     PRIMARY KEY (NUM_CUENTA)                      
 )                                                 
 IN IBMUSER1.CLIENTES;                             
 CREATE UNIQUE INDEX IDX_BANC_CLIENTE_DNI          
     ON BANC_CLIENTE (DNI);                        
 

 CREATE TABLE BANC_CUENTA                                    
 (                                                           
     NUM_CUENTA     CHAR(10)      NOT NULL,                  
     TIPO_CUENTA    CHAR(02)      NOT NULL,                  
     SALDO          DECIMAL(12,2) NOT NULL DEFAULT 0,        
     DIVISA         CHAR(03)      NOT NULL DEFAULT 'EUR',    
     LIMITE_DIARIO  DECIMAL(12,2) NOT NULL DEFAULT 600.00,   
     FECHA_ULT_MOV  DATE          NOT NULL,                  
     PRIMARY KEY (NUM_CUENTA),                               
     FOREIGN KEY (NUM_CUENTA)                                
         REFERENCES BANC_CLIENTE (NUM_CUENTA)                
 )                                                           
   IN IBMUSER1.CLIENTES;                                     
   CREATE UNIQUE INDEX IDX_BANC_CUENTA_IPK                   
   ON BANC_CUENTA                                            
 (                                                           
     NUM_CUENTA                                              
 );                                                          



CREATE TABLE BANC_INGRESO                                
(                                                        
    ID_INGRESO INTEGER NOT NULL                          
                 GENERATED ALWAYS AS IDENTITY,           
    NUM_CUENTA CHAR(10)      NOT NULL,                   
    FECHA_ING  DATE          NOT NULL,                   
    IMPORTE    DECIMAL(10,2) NOT NULL,                   
    FORMA_PAGO CHAR(02)      NOT NULL,                   
    ORDENANTE  VARCHAR(60),                              
    ESTADO     CHAR(01)      NOT NULL DEFAULT 'P',       
    PRIMARY KEY (ID_INGRESO),                            
    FOREIGN KEY (NUM_CUENTA)                             
        REFERENCES BANC_CUENTA (NUM_CUENTA)              
)                                                        
IN IBMUSER1.CLIENTES;                                    
CREATE UNIQUE INDEX BANC_INGRESO_IPK                     
ON BANC_INGRESO                                          
(                                                        
    ID_INGRESO                                           
);                                                       
CREATE INDEX BANC_INGRESO_CTA                            
ON BANC_INGRESO                                          
(                                                        
    NUM_CUENTA                                           
);                                                       




 
 CREATE TABLE BANC_MOVIMIENTO                            
 (                                                       
     ID_MOVIMIENTO INTEGER NOT NULL                      
