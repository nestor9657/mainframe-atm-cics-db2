    ID_OPER                                                          
);                                                                   
CREATE INDEX BANC_OTRAS_OPER_CTA                                     
ON BANC_OTRAS_OPER                                                   
(                                                                    
    NUM_CUENTA                                                       
);                                                                   
 
 




