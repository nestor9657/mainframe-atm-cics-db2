CREATE TABLE BANC_OTRAS_OPER                                         
(                                                                    
    ID_OPER      INTEGER NOT NULL                                    
                   GENERATED ALWAYS AS IDENTITY,                     
    NUM_CUENTA   CHAR(10)      NOT NULL,                             
    FECHA_OPER   DATE          NOT NULL,                             
